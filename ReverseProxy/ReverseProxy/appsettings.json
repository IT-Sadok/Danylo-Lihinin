{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "booking-route": {
        "RateLimiterPolicy": "sliding",
        "ClusterId": "booking-cluster",
        "Order": 1,
        "Match": {
          "Path": "/{**catch-all}"
        }
      },

      "audit-route": {
        "RateLimiterPolicy": "sliding",
        "ClusterId": "audit-cluster",
        "Order": 0,
        "Match": {
          "Path": "/audit/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "booking-api": {
            "Address": "http://localhost:5138/"
          }
        }
      },

      "audit-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "audit-api-1": {"Address": "http://localhost:5069/"},
          "audit-api-2": {"Address": "http://localhost:5070/"},
          "audit-api-3": {"Address": "http://localhost:5071/"}
        }
      }
    }
  }
}
